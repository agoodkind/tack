# Ignore compiled binaries.
/server
/tack
/mcp-client

# Ignore the build cache.
/dist/

# Ignore Make includes that the build downloads at runtime.
.make/

# Ignore local environment files.
.env
.env.*
!.env.example

# Ignore local secrets.
.secrets/

# Ignore macOS metadata.
.DS_Store

# Ignore editor files.
.idea/
.vscode/
*.swp

# Ignore Python cache files.
__pycache__/
*.pyc
.test-fdb/
.testenv/
.test-audit-db/
lm-review-report-*.md
trace.*.json
trace.*.xml

