diff --git a/postgresql/role_external.go b/postgresql/role_external.go
new file mode 100644
index 0000000..cc1912f
--- /dev/null
+++ b/postgresql/role_external.go
@@ -0,0 +1,282 @@
+package postgresql
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"sync"
+
+	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
+	"github.com/lib/pq"
+)
+
+const (
+	roleLockModeAttr     = "role_lock_mode"
+	roleLockModeAdvisory = "advisory"
+	roleLockModeExternal = "external"
+	roleOIDAttr          = "role_oid"
+)
+
+// externalRoleWriteMutex serializes postgresql_role create, update, and delete
+// calls inside this provider process when role_lock_mode is external. The
+// deployment controller must serialize provider instances and hold the real
+// host and backend locks.
+var externalRoleWriteMutex sync.Mutex
+
+func (c *Config) externalRoleLocking() bool {
+	return c.RoleLockMode == roleLockModeExternal
+}
+
+// managedRole is the database role that a resource state identifies.
+type managedRole struct {
+	oid   int64
+	name  string
+	found bool
+}
+
+func lookupRoleNameByOID(db QueryAble, oid int64) (string, bool, error) {
+	var name string
+	err := db.QueryRow("SELECT rolname FROM pg_catalog.pg_roles WHERE oid = $1", oid).Scan(&name)
+	switch {
+	case errors.Is(err, sql.ErrNoRows):
+		return "", false, nil
+	case err != nil:
+		return "", false, fmt.Errorf("could not read the name of role OID %d: %w", oid, err)
+	}
+	return name, true, nil
+}
+
+func lookupRoleOIDByName(db QueryAble, name string) (int64, bool, error) {
+	var oid int64
+	err := db.QueryRow("SELECT oid::bigint FROM pg_catalog.pg_roles WHERE rolname = $1", name).Scan(&oid)
+	switch {
+	case errors.Is(err, sql.ErrNoRows):
+		return 0, false, nil
+	case err != nil:
+		return 0, false, fmt.Errorf("could not read the OID of role %s: %w", name, err)
+	}
+	return oid, true, nil
+}
+
+// resolveManagedRole finds the role that the resource state identifies. It looks
+// up the stored role_oid before the name. A renamed role is found under its
+// current name, and a different role that has the old name is never adopted.
+func resolveManagedRole(db QueryAble, d *schema.ResourceData) (managedRole, error) {
+	storedOID := int64(d.Get(roleOIDAttr).(int))
+	if storedOID == 0 {
+		oid, found, err := lookupRoleOIDByName(db, d.Id())
+		if err != nil {
+			return managedRole{}, err
+		}
+		return managedRole{oid: oid, name: d.Id(), found: found}, nil
+	}
+
+	name, found, err := lookupRoleNameByOID(db, storedOID)
+	if err != nil {
+		return managedRole{}, err
+	}
+	if found {
+		return managedRole{oid: storedOID, name: name, found: true}, nil
+	}
+
+	otherOID, nameTaken, err := lookupRoleOIDByName(db, d.Id())
+	if err != nil {
+		return managedRole{}, err
+	}
+	if nameTaken {
+		return managedRole{}, fmt.Errorf(
+			"role identity conflict: the role with OID %d no longer exists, and a different role with OID %d has the name %s; "+
+				"remove the resource from state or restore the original role before applying",
+			storedOID, otherOID, d.Id(),
+		)
+	}
+	return managedRole{oid: storedOID, name: d.Id(), found: false}, nil
+}
+
+func resourcePostgreSQLRoleExistsExternal(db *DBConnection, d *schema.ResourceData) (bool, error) {
+	role, err := resolveManagedRole(db, d)
+	if err != nil {
+		return false, err
+	}
+	return role.found, nil
+}
+
+func rejectExternalRoleMemberships(roles *schema.Set) error {
+	if roles.Len() == 0 {
+		return nil
+	}
+	return fmt.Errorf(
+		"%s is not supported when %s is %q: the role resource does not reconcile memberships in this mode; "+
+			"remove %s from the postgresql_role resource and manage grants with postgresql_grant_role",
+		roleRolesAttr, roleLockModeAttr, roleLockModeExternal, roleRolesAttr,
+	)
+}
+
+func customizeRoleDiff(_ context.Context, diff *schema.ResourceDiff, meta any) error {
+	client, ok := meta.(*Client)
+	if !ok || !client.config.externalRoleLocking() {
+		return nil
+	}
+	roles, _ := diff.Get(roleRolesAttr).(*schema.Set)
+	if roles == nil {
+		return nil
+	}
+	return rejectExternalRoleMemberships(roles)
+}
+
+// failExternalRoleWrite finishes the failed transaction, reads the original role
+// OID through the connection pool, and keeps the resource ID at the actual role
+// name. It returns the original error, joined with any readback error.
+func failExternalRoleWrite(db *DBConnection, d *schema.ResourceData, txn *sql.Tx, role managedRole, writeErr error) error {
+	if rollbackErr := txn.Rollback(); rollbackErr != nil && !errors.Is(rollbackErr, sql.ErrTxDone) {
+		return errors.Join(writeErr, fmt.Errorf("could not roll back the failed transaction: %w", rollbackErr))
+	}
+	name, found, readErr := lookupRoleNameByOID(db, role.oid)
+	if readErr != nil {
+		return errors.Join(writeErr, fmt.Errorf("could not read role OID %d after the failed write: %w", role.oid, readErr))
+	}
+	if found {
+		d.SetId(name)
+	}
+	return writeErr
+}
+
+func externalRoleStatements(db *DBConnection, txn *sql.Tx, d *schema.ResourceData, role managedRole) error {
+	if err := setExternalRoleName(txn, d, role); err != nil {
+		return err
+	}
+	steps := []func() error{
+		func() error { return setRolePassword(txn, d) },
+		func() error { return setRoleBypassRLS(db, txn, d) },
+		func() error { return setRoleConnLimit(txn, d) },
+		func() error { return setRoleCreateDB(txn, d) },
+		func() error { return setRoleCreateRole(txn, d) },
+		func() error { return setRoleInherit(txn, d) },
+		func() error { return setRoleLogin(txn, d) },
+		func() error { return setRoleReplication(txn, d) },
+		func() error { return setRoleSuperuser(txn, d) },
+		func() error { return setRoleValidUntil(txn, d) },
+		func() error { return alterSearchPath(txn, d) },
+		func() error { return setStatementTimeout(txn, d) },
+		func() error { return setIdleInTransactionSessionTimeout(txn, d) },
+		func() error { return setAssumeRole(txn, d) },
+	}
+	for _, step := range steps {
+		if err := step(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// setExternalRoleName renames the role from its current database name. It does
+// nothing when the role already has the requested name.
+func setExternalRoleName(txn *sql.Tx, d *schema.ResourceData, role managedRole) error {
+	requested := d.Get(roleNameAttr).(string)
+	if requested == "" {
+		return errors.New("error setting role name to an empty string")
+	}
+	if requested == role.name {
+		return nil
+	}
+	rename := fmt.Sprintf("ALTER ROLE %s RENAME TO %s", pq.QuoteIdentifier(role.name), pq.QuoteIdentifier(requested))
+	if _, err := txn.Exec(rename); err != nil {
+		return fmt.Errorf("error updating role NAME: %w", err)
+	}
+	d.SetId(requested)
+	return nil
+}
+
+func resourcePostgreSQLRoleUpdateExternal(db *DBConnection, d *schema.ResourceData) error {
+	externalRoleWriteMutex.Lock()
+	defer externalRoleWriteMutex.Unlock()
+
+	if err := rejectExternalRoleMemberships(d.Get(roleRolesAttr).(*schema.Set)); err != nil {
+		return err
+	}
+	role, err := resolveManagedRole(db, d)
+	if err != nil {
+		return err
+	}
+	if !role.found {
+		return fmt.Errorf("role OID %d (%s) does not exist; refresh the state before applying", role.oid, d.Id())
+	}
+	if d.Get(roleOIDAttr).(int) == 0 && d.Get(roleNameAttr).(string) != role.name {
+		return fmt.Errorf(
+			"the state of role %s has no %s; run a refresh to record the role identity before renaming the role",
+			role.name, roleOIDAttr,
+		)
+	}
+
+	txn, err := startTransaction(db.client, "")
+	if err != nil {
+		return err
+	}
+	defer deferredRollback(txn)
+
+	if err := externalRoleStatements(db, txn, d, role); err != nil {
+		return failExternalRoleWrite(db, d, txn, role, err)
+	}
+	if err := txn.Commit(); err != nil {
+		return failExternalRoleWrite(db, d, txn, role, fmt.Errorf("could not commit transaction: %w", err))
+	}
+
+	d.Partial(false)
+	return resourcePostgreSQLRoleReadImpl(db, d)
+}
+
+func resourcePostgreSQLRoleDeleteExternal(db *DBConnection, d *schema.ResourceData) error {
+	externalRoleWriteMutex.Lock()
+	defer externalRoleWriteMutex.Unlock()
+
+	role, err := resolveManagedRole(db, d)
+	if err != nil {
+		return err
+	}
+	if !role.found {
+		d.SetId("")
+		return nil
+	}
+
+	txn, err := startTransaction(db.client, "")
+	if err != nil {
+		return err
+	}
+	defer deferredRollback(txn)
+
+	if err := dropExternalRole(db, txn, d, role.name); err != nil {
+		return failExternalRoleWrite(db, d, txn, role, err)
+	}
+	if err := txn.Commit(); err != nil {
+		return failExternalRoleWrite(db, d, txn, role, fmt.Errorf("error committing schema: %w", err))
+	}
+
+	d.SetId("")
+	return nil
+}
+
+func dropExternalRole(db *DBConnection, txn *sql.Tx, d *schema.ResourceData, roleName string) error {
+	if !d.Get(roleSkipReassignOwnedAttr).(bool) {
+		err := withRolesGranted(txn, []string{roleName}, func() error {
+			currentUser := db.client.config.getDatabaseUsername()
+			reassign := fmt.Sprintf("REASSIGN OWNED BY %s TO %s", pq.QuoteIdentifier(roleName), pq.QuoteIdentifier(currentUser))
+			if _, err := txn.Exec(reassign); err != nil {
+				return fmt.Errorf("could not reassign owned by role %s to %s: %w", roleName, currentUser, err)
+			}
+			if _, err := txn.Exec(fmt.Sprintf("DROP OWNED BY %s", pq.QuoteIdentifier(roleName))); err != nil {
+				return fmt.Errorf("could not drop owned by role %s: %w", roleName, err)
+			}
+			return nil
+		})
+		if err != nil {
+			return err
+		}
+	}
+	if !d.Get(roleSkipDropRoleAttr).(bool) {
+		if _, err := txn.Exec(fmt.Sprintf("DROP ROLE %s", pq.QuoteIdentifier(roleName))); err != nil {
+			return fmt.Errorf("could not delete role %s: %w", roleName, err)
+		}
+	}
+	return nil
+}
