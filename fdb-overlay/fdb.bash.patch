+function bracketed() {
+    local ip="$1"
+    if [[ "$ip" == *:* ]]; then
+        echo "[$ip]"
+    else
+        echo "$ip"
+    fi
+}
 
 function create_cluster_file() {
     FDB_CLUSTER_FILE=${FDB_CLUSTER_FILE:-/etc/foundationdb/fdb.cluster}
