# Build the Go test binaries with the production server's
# FoundationDB client library version. The internal/testenv
# package attaches the running container to the engines'
# network. FoundationDB reconnects use engine addresses
# directly and bypass Docker Desktop's host port forwarding.

ARG FDB_VERSION=7.4.6

FROM golang:1.27.3-bookworm

ARG FDB_VERSION

# Install the FoundationDB C client library for CGO linking. Match the
# build platform's architecture to support Apple Silicon and amd64 hosts.
RUN set -eux \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates dumb-init \
    && case "$(dpkg --print-architecture)" in \
         amd64)  fdb_arch=amd64 ;; \
         arm64)  fdb_arch=aarch64 ;; \
         *) echo "unsupported arch: $(dpkg --print-architecture)" >&2; exit 1 ;; \
       esac \
    && curl -fsSL \
       https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_${fdb_arch}.deb \
       -o /tmp/fdb-clients.deb \
    && dpkg -i /tmp/fdb-clients.deb \
    && rm /tmp/fdb-clients.deb \
    && apt-get remove -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Cache module downloads when the module files do not change.
COPY go.mod go.sum ./
RUN go mod download

# The container runs go test against the working tree's
# bind mount. Docker mounts the remaining source at
# runtime, and the Make targets supply the Go arguments.
ENV CGO_ENABLED=1

# `docker compose run` forwards SIGTERM to the main process, and `docker stop`
# sends it too. The go command exits on SIGTERM, and the kernel then kills the
# test binary before testenv removes the engines. After the first test binary
# starts, the go command keeps running on SIGINT. dumb-init sends each signal to
# the whole process group and sends SIGINT in place of SIGTERM. The test binary
# then removes its engines and exits, and the go command exits after it.
ENTRYPOINT ["/usr/bin/dumb-init", "--rewrite", "15:2", "--", "/usr/local/go/bin/go"]
