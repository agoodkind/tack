# Copy this file to `.env` and fill in real values. docker compose will refuse
# to start any service that references a `:?` env var without a value set.
# There are no default fallbacks for credentials.
#
# Generate a strong password with:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40

# YugabyteDB credentials. Required by the app DATABASE_URL, the yugabyte
# container's first-boot init, and the yugabyte healthcheck.
YUGABYTE_USER=yugabyte
YUGABYTE_DB=tack
# Set with: openssl rand -base64 32 | tr -d '/+=' | head -c 40
YUGABYTE_PASSWORD=

# Audit ledger DSNs. `./server ops audit seed-roles` creates the
# tack_audit_{writer,reader,redactor,operator} login roles with these passwords.
# Build each DSN as a postgres URL pointing at the matching role and the
# YUGABYTE_DB above; sslmode=disable for in-cluster traffic on CT 117.
# Leaving any of these unset degrades that subsystem to noop.
AUDIT_WRITER_PASSWORD=
AUDIT_READER_PASSWORD=
AUDIT_REDACTOR_PASSWORD=
AUDIT_OPERATOR_PASSWORD=
# The application's own login (TACK-180). The same seed-roles run creates
# tack_app with this password; the app DATABASE_URL connects as tack_app and
# holds only users, api_tokens, and org_members. Required by the app service.
TACK_APP_PASSWORD=
AUDIT_WRITER_DSN=
AUDIT_READER_DSN=
AUDIT_REDACTOR_DSN=
AUDIT_OPERATOR_DSN=
# Host-networked tack-ops uses 127.0.0.1:5433 instead of the bridge hostname.
TACK_OPS_AUDIT_OPERATOR_DSN=

# App listen port and environment.
PORT=8000
ENV=development
LOG_LEVEL=debug

# Meilisearch master key. Required: the search engine, the app, and the ops
# sidecar all read it and none carries a fallback. Pick any value locally;
# a deployment gets a real secret from the configs repo.
MEILI_MASTER_KEY=

# Optional. Empty disables OTEL tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Apache Kafka cluster ID for the Wave 1 audit broker. Generate once with:
#   docker run --rm apache/kafka:4.2.0 /opt/kafka/bin/kafka-storage.sh random-uuid
# Persist the value here so a recreate does not stamp a fresh metadata dir.
KAFKA_CLUSTER_ID=

# Wave 1 audit producer wiring. Empty AUDIT_KAFKA_BROKERS disables the
# Kafka path and the server falls back to WAL-only recording.
AUDIT_KAFKA_BROKERS=
AUDIT_KAFKA_TOPIC=audit.events.v1
AUDIT_KAFKA_CLIENT_ID=tack-audit-producer
AUDIT_KAFKA_PRODUCE_TIMEOUT=15s

# Wave 1 audit consumer (cmd/audit-consumer). The consumer reads from the
# Kafka topic the producer writes to and projects events into Yugabyte
# audit.events_v2 plus ClickHouse audit.events. Leave AUDIT_CONSUMER_*
# unset to keep the consumer disabled.
AUDIT_CONSUMER_KAFKA_BROKERS=
AUDIT_CONSUMER_KAFKA_TOPIC=audit.events.v1
AUDIT_CONSUMER_GROUP_ID=tack-audit-projector
AUDIT_CONSUMER_BATCH_SIZE=256
AUDIT_CONSUMER_POLL_INTERVAL=250ms
AUDIT_CONSUMER_YUGABYTE_DSN=
AUDIT_CONSUMER_CLICKHOUSE_DSN=clickhouse://default:@clickhouse:9000/audit
AUDIT_CONSUMER_SIGNING_KEY_PATH=/etc/tack/audit-signing.pem

# Wave 1 audit-consumer monitoring knobs. The lag threshold drives the
# `consumer.lag.high` warning emitted on every poll where lag exceeds the
# value. SummaryEvery is how many records the consumer accumulates before
# emitting a `consumer.processed` debug summary.
TACK_AUDIT_CONSUMER_LAG_WARN_MESSAGES=1000
TACK_AUDIT_CONSUMER_SUMMARY_EVERY=100

# Optional backup overrides for `./server ops backup`. This is a common subset;
# internal/config/config.go declares the TACK_BACKUP_* variables the ops backup
# commands read, and docker-compose.yml also consumes TACK_BACKUP_S3_HOST for the
# backup agent. Production defaults match CT 117 layout; only set these for
# wet-run paths or test environments.
# TACK_BACKUP_ROOT=/root/backups
# TACK_BACKUP_FDB_NETWORK=tack_default
# TACK_BACKUP_FDB_IMAGE=foundationdb/foundationdb:7.4.6
# TACK_BACKUP_MEILI_VOLUME=tack_meili-data
# TACK_BACKUP_TEMPORAL_DB_USER=<docker-compose temporal-db default>
# TACK_BACKUP_TEMPORAL_DB_PASSWORD=<docker-compose temporal-db default>
# TACK_BACKUP_TEMPORAL_DB_NAME=<docker-compose temporal-db default>

# Enables the FoundationDB half of the operator audit relay inside the
# audit-consumer. Set it to /etc/foundationdb/fdb.cluster on a host that has
# the cluster file. Left unset, the consumer relays only the YugabyteDB
# outbox rather than refusing to start.
AUDIT_CONSUMER_FDB_CLUSTER_FILE=


# Product store identity for this guest (TACK-408). A deployed guest that runs
# a store process announces its own pinned address and names itself as the
# fault domain; the deploy renders all three from the service inventory.
# Leaving them empty, as local development does, announces the container's own
# address and hostname.
FDB_PUBLIC_ADDRESS=
FDB_ZONE_ID=
FDB_MACHINE_ID=
# The coordinator list a store process starts from the first time it runs on a
# guest, for example docker:docker@[3d06:bad:b01:210::220]:4500. The process
# leaves it alone once a cluster file exists, because the cluster owns that
# file and writes each coordinator change into it. Empty locally, where the
# process is its own coordinator.
FDB_CLUSTER_FILE_CONTENTS=
# How long one product-store transaction may run, its retries included.
FDB_TRANSACTION_TIMEOUT=5s
# The redundancy `ops provision` configures on a store that has never been
# configured: single, double, or triple. It changes nothing on a configured
# cluster.
TACK_OPS_FDB_REDUNDANCY_MODE=single

# Event queue identity for this guest (TACK-409). These are the single-broker
# values; a deploy renders per-guest values from the service inventory.
TACK_QUEUE_NODE_ID=1
TACK_QUEUE_CONTROLLER_VOTERS=1@kafka:9093
TACK_QUEUE_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
TACK_QUEUE_PROBE=/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server kafka:9092
# The broker applies both counts to topics it creates from here on.
TACK_QUEUE_REPLICATION_FACTOR=1
TACK_QUEUE_MIN_INSYNC_REPLICAS=1
# The audit-consumer writes this onto the audit topic on every start. A value
# above that topic's copy count fails every write with NOT_ENOUGH_REPLICAS.
TACK_QUEUE_AUDIT_TOPIC_MIN_INSYNC=0
