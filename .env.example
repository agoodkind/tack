# Copy this file to .env and set real values. Docker Compose
# refuses to start a service when a required :? environment
# variable lacks a value. Credentials do not have default values.
#
# Generate a strong password with this command:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40

# YugabyteDB uses these credentials during first initialization and health
# checks. The app DATABASE_URL uses the separate tack_app credentials below.
YUGABYTE_USER=yugabyte
YUGABYTE_DB=tack
# Set with: openssl rand -base64 32 | tr -d '/+=' | head -c 40
YUGABYTE_PASSWORD=

# The ./server ops audit seed-roles command creates the
# tack_audit_{writer,reader,redactor,operator} login roles with these
# passwords. Build each database connection string (DSN) as a postgres URL
# for its role and YUGABYTE_DB. CT 117 used sslmode=disable for cluster
# traffic. Missing audit recording configuration prevents normal server startup.
AUDIT_WRITER_PASSWORD=
AUDIT_READER_PASSWORD=
AUDIT_REDACTOR_PASSWORD=
AUDIT_OPERATOR_PASSWORD=
# The same seed-roles command creates the app's required tack_app
# login with this password (TACK-180). The app DATABASE_URL uses
# tack_app, which can access only users, api_tokens, and org_members.
TACK_APP_PASSWORD=
AUDIT_WRITER_DSN=
AUDIT_READER_DSN=
AUDIT_REDACTOR_DSN=
AUDIT_OPERATOR_DSN=
# Host-networked tack-ops uses 127.0.0.1:5433 instead of the bridge hostname.
TACK_OPS_AUDIT_OPERATOR_DSN=

# Set the app's listening port and environment.
PORT=8000
ENV=development
LOG_LEVEL=debug

# Leave the optional OTEL endpoint empty to disable tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Generate the Wave 1 audit broker's Apache Kafka cluster ID once:
#   docker run --rm apache/kafka:4.2.0 /opt/kafka/bin/kafka-storage.sh random-uuid
# Save the ID here; recreating the broker must not replace its metadata directory.
KAFKA_CLUSTER_ID=

# Set AUDIT_KAFKA_BROKERS to enable the Wave 1 Kafka producer. An empty
# value selects synchronous YugabyteDB recording when AUDIT_WRITER_DSN is set.
AUDIT_KAFKA_BROKERS=
AUDIT_KAFKA_TOPIC=audit.events.v1
AUDIT_KAFKA_CLIENT_ID=tack-audit-producer
AUDIT_KAFKA_PRODUCE_TIMEOUT=15s

# The audit consumer records Kafka events in YugabyteDB audit.events.
AUDIT_CONSUMER_KAFKA_BROKERS=
AUDIT_CONSUMER_KAFKA_TOPIC=audit.events.v1
AUDIT_CONSUMER_GROUP_ID=tack-audit-projector
AUDIT_CONSUMER_BATCH_SIZE=256
AUDIT_CONSUMER_POLL_INTERVAL=250ms
AUDIT_CONSUMER_YUGABYTE_DSN=
AUDIT_CONSUMER_SIGNING_KEY_PATH=/etc/tack/audit-signing.pem

# The Wave 1 audit consumer logs a consumer.lag.high
# warning on every poll when a partition's lag equals or
# exceeds TACK_AUDIT_CONSUMER_LAG_WARN_MESSAGES. SummaryEvery
# counts the records between consumer.processed debug summaries.
TACK_AUDIT_CONSUMER_LAG_WARN_MESSAGES=1000
TACK_AUDIT_CONSUMER_SUMMARY_EVERY=100

# These optional ./server ops backup overrides cover a common subset
# of TACK_BACKUP_* settings. The config fields define the backup
# command settings; Compose also uses TACK_BACKUP_S3_HOST for the
# backup agent. The defaults match the recorded CT 117 layout. Set
# overrides only for runs that perform backup work or for test environments.
# TACK_BACKUP_ROOT=/root/backups
# TACK_BACKUP_FDB_NETWORK=tack_default
# TACK_BACKUP_FDB_IMAGE=foundationdb/foundationdb:7.4.6

# Set AUDIT_CONSUMER_FDB_CLUSTER_FILE to
# /etc/foundationdb/fdb.cluster on a host with that file to enable the
# audit-consumer's FoundationDB operator audit relay. An empty value
# runs only the YugabyteDB outbox relay and does not prevent startup.
AUDIT_CONSUMER_FDB_CLUSTER_FILE=


# Configure the product store's address, zone, and machine identity
# through Configs (TACK-408). The former Ansible deploy rendered all
# three from the service inventory. A store guest announces its pinned
# address and uses the guest as its fault domain. Local development
# leaves the values empty and announces the container's address and hostname.
FDB_PUBLIC_ADDRESS=
FDB_ZONE_ID=
FDB_MACHINE_ID=
# Set the coordinator list for a guest's first store process,
# for example docker:docker@[3d06:bad:b01:210::220]:4500. Once
# a cluster file exists, the process preserves it and the
# cluster writes coordinator changes into it. Leave this value
# empty locally, where the process coordinates its own cluster.
FDB_CLUSTER_FILE_CONTENTS=
# Set the shared database default for product-store transaction timeouts, including retries.
# Operations can override it with their own timeout or a context-based limit.
FDB_TRANSACTION_TIMEOUT=5s
# The ops provision command sets single, double, or
# triple redundancy only when the store lacks a database
# configuration. It does not change a configured cluster.
TACK_OPS_FDB_REDUNDANCY_MODE=single
