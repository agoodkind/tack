# Copy this file to `.env` and fill in real values. docker compose refuses
# to start a service when a referenced `:?` environment variable is empty.
# Credentials do not have defaults.
#
# Generate a strong password with:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40

# The app DATABASE_URL, yugabyte first-boot initialization, and health check
# require these YugabyteDB credentials.
YUGABYTE_USER=yugabyte
YUGABYTE_DB=tack
# Set with: openssl rand -base64 32 | tr -d '/+=' | head -c 40
YUGABYTE_PASSWORD=

# `./server ops audit seed-roles` creates the
# tack_audit_{writer,reader,redactor,operator} login roles with these passwords.
# Build each DSN as a postgres URL for the matching role and YUGABYTE_DB;
# use sslmode=disable for in-cluster traffic on CT 117.
# An unset DSN disables its subsystem.
AUDIT_WRITER_PASSWORD=
AUDIT_READER_PASSWORD=
AUDIT_REDACTOR_PASSWORD=
AUDIT_OPERATOR_PASSWORD=
# seed-roles creates tack_app with this password (TACK-180).
# The app DATABASE_URL connects as tack_app, which can access only users,
# api_tokens, and org_members. The app service requires this password.
TACK_APP_PASSWORD=
AUDIT_WRITER_DSN=
AUDIT_READER_DSN=
AUDIT_REDACTOR_DSN=
AUDIT_OPERATOR_DSN=
# Host-networked tack-ops uses 127.0.0.1:5433 instead of the bridge hostname.
TACK_OPS_AUDIT_OPERATOR_DSN=

# Configure the app listen port and environment.
PORT=8000
ENV=development
LOG_LEVEL=debug

# An empty OTEL_EXPORTER_OTLP_ENDPOINT disables OTEL tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Generate the Apache Kafka cluster ID once with:
#   docker run --rm apache/kafka:4.2.0 /opt/kafka/bin/kafka-storage.sh random-uuid
# Preserve this value across container recreation to reuse existing metadata.
KAFKA_CLUSTER_ID=

# An empty AUDIT_KAFKA_BROKERS disables Kafka publication.
# The server then uses WAL-only recording.
AUDIT_KAFKA_BROKERS=
AUDIT_KAFKA_TOPIC=audit.events.v1
AUDIT_KAFKA_CLIENT_ID=tack-audit-producer
AUDIT_KAFKA_PRODUCE_TIMEOUT=15s

# The audit consumer records Kafka events in YugabyteDB audit.events.
AUDIT_CONSUMER_KAFKA_BROKERS=
AUDIT_CONSUMER_KAFKA_TOPIC=audit.events.v1
AUDIT_CONSUMER_GROUP_ID=tack-audit-projector
AUDIT_CONSUMER_BATCH_SIZE=256
AUDIT_CONSUMER_POLL_INTERVAL=250ms
AUDIT_CONSUMER_YUGABYTE_DSN=
AUDIT_CONSUMER_SIGNING_KEY_PATH=/etc/tack/audit-signing.pem

# The consumer emits consumer.lag.high on each poll above the lag threshold.
# SummaryEvery sets the record count between consumer.processed debug summaries.
TACK_AUDIT_CONSUMER_LAG_WARN_MESSAGES=1000
TACK_AUDIT_CONSUMER_SUMMARY_EVERY=100

# Override backup settings for `./server ops backup` only in wet-run paths
# or test environments. Production defaults match the CT 117 layout.
# internal/config/config.go declares TACK_BACKUP_* variables for backup commands;
# docker-compose.yml reads TACK_BACKUP_S3_HOST for the backup agent.
# TACK_BACKUP_ROOT=/root/backups
# TACK_BACKUP_FDB_NETWORK=tack_default
# TACK_BACKUP_FDB_IMAGE=foundationdb/foundationdb:7.4.6

# Enable the audit-consumer's FoundationDB operator audit relay with
# /etc/foundationdb/fdb.cluster on a host with that cluster file.
# When unset, the consumer relays only the YugabyteDB outbox.
AUDIT_CONSUMER_FDB_CLUSTER_FILE=


# Deployed store processes announce their guest's pinned address and use
# the guest identity as the replication fault domain (TACK-408).
# The deploy renders these values from the service inventory.
# Empty local values select the container's address and hostname.
FDB_PUBLIC_ADDRESS=
FDB_ZONE_ID=
FDB_MACHINE_ID=
# A store process uses this coordinator list on its first start on a guest,
# for example docker:docker@[3d06:bad:b01:210::220]:4500. After a cluster file
# exists, FoundationDB updates its coordinator list without reading this value.
# Leave it empty locally when the process acts as its own coordinator.
FDB_CLUSTER_FILE_CONTENTS=
# Limit each product-store transaction's duration, including retries.
FDB_TRANSACTION_TIMEOUT=5s
# `ops provision` uses single, double, or triple redundancy when configuring
# a new store. It does not change redundancy on an existing cluster.
TACK_OPS_FDB_REDUNDANCY_MODE=single
