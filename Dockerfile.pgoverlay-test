# Run the PostgreSQL provider overlay tests in this image. The
# normal test runner does not build the provider or install
# OpenTofu. This image builds the patched provider through
# postgresql-overlay's go-makefile build and installs pinned
# OpenTofu. Both match the runner's architecture. The
# internal/testenv package attaches the running container to the test
# engines' network. TOFU_VERSION and its checksums define the OpenTofu version pin.

ARG TOFU_VERSION=1.13.2

FROM golang:1.27.3-bookworm AS provider
WORKDIR /overlay
COPY postgresql-overlay/Makefile postgresql-overlay/bootstrap.mk postgresql-overlay/go.mod postgresql-overlay/go.sum \
     postgresql-overlay/.go-mk-applied-notices \
     postgresql-overlay/.golangci-lint-baseline.txt postgresql-overlay/.staticcheck-extra-baseline.txt \
     postgresql-overlay/.gocyclo-baseline.txt postgresql-overlay/.deadcode-baseline.txt \
     postgresql-overlay/main.go postgresql-overlay/role-state.patch ./
RUN make build

# The OpenTofu release publishes these SHA-256
# checksums for the TOFU_VERSION Linux archives.
# Update both checksums whenever the version changes.
FROM debian:bookworm-slim AS tofu
ARG TOFU_VERSION
ARG TOFU_SHA256_AMD64=ac05d9952662c7db28dd57e93f0a68018837bfdf9342384ec0987977c16a9645
ARG TOFU_SHA256_ARM64=88e2d9e3f94f97b76ab2faf55ade87578f56aed19c5e45fa139d70e994366d1f
RUN set -eux \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && case "$(dpkg --print-architecture)" in \
         amd64) tofu_arch=amd64; tofu_sha256="${TOFU_SHA256_AMD64}" ;; \
         arm64) tofu_arch=arm64; tofu_sha256="${TOFU_SHA256_ARM64}" ;; \
         *) echo "unsupported arch: $(dpkg --print-architecture)" >&2; exit 1 ;; \
       esac \
    && curl -fsSL \
       "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_${tofu_arch}.tar.gz" \
       -o /tmp/tofu.tar.gz \
    && echo "${tofu_sha256}  /tmp/tofu.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/tofu.tar.gz -C /usr/local/bin tofu

FROM golang:1.27.3-bookworm
ARG TOFU_VERSION

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY --from=provider /overlay/dist/terraform-provider-postgresql /opt/overlay/terraform-provider-postgresql
COPY --from=tofu /usr/local/bin/tofu /usr/local/bin/tofu

# These tests do not link FoundationDB; disable CGO. They run tofu
# through the Docker SDK in this container with the provider in /opt/overlay.
ENV CGO_ENABLED=0 \
    TACK_PG_OVERLAY_TOFU_VERSION=${TOFU_VERSION}

ENTRYPOINT ["/usr/local/go/bin/go"]
