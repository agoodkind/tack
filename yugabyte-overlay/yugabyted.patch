+    # tack overlay: send SIGTERM to the tserver, then the master, and wait
+    # for each to exit within one shared deadline. A server this process
+    # did not start (self.process unset) or that already exited is skipped.
+    def terminate_servers(self, deadline_seconds):
+        deadline = time.time() + deadline_seconds
+        for name in ("tserver", "master"):
+            p = self.processes.get(name)
+            if p is None or p.process is None or p.process.poll() is not None:
+                continue
+            try:
+                p.process.send_signal(SIGTERM)
+            except OSError as err:
+                Output.log("Failed to signal {}: {}".format(name, str(err)))
+                continue
+            while p.process.poll() is None and time.time() < deadline:
+                time.sleep(0.5)
+            if p.process.poll() is None:
+                Output.log("{} did not stop within {} s".format(name, deadline_seconds))
+            else:
+                Output.log("{} stopped with status {}".format(name, p.process.returncode))
 
