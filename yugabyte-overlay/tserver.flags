# yugabyted reads one tserver flag per line from this read-only bind mount
# in the yugabyte service. docker-compose.yml selects the file with
# --tserver_flags=flagfile=.... Keep these values only in this file.

# Cap YSQL connections; every backend costs memory inside the hard limit
# below.
--ysql_pg_conf_csv=max_connections=100

# Hard process ceiling: 8 GiB. Together with the fixed block cache below this
# replaces use_memory_defaults_optimized_for_ysql self-sizing, which sizes
# from guest RAM and let a full-table scan grow the tserver to 13.7 GiB and
# starve the guest's page cache (2026-08-05 S0). Must stay under the compose
# mem_limit.
--memory_limit_hard_bytes=8589934592

# Fixed block cache: 2 GiB.
--db_block_cache_size_bytes=2147483648

# Create one tablet per new table and index. The three-tablet default
# replicated 383 tablets per node for 1.6 GB of data. Raft heartbeats used
# about 0.4 CPU core per node at idle (TACK-493). Automatic tablet splitting
# remains enabled for growing tables; small tables start with one tablet.
--ysql_num_tablets=1
